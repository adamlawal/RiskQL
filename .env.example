# RiskQL environment configuration (EXAMPLE)
# Copy this file to `.env` and adjust for your local Postgres.
#   cp .env.example .env
# `.env` is git-ignored and must NEVER be committed.

# Full connection string used by Python (SQLAlchemy / psycopg2).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Homebrew Postgres on macOS often needs no password:
DATABASE_URL=postgresql://localhost:5432/riskql

# Individual libpq variables (used by psql if you export them).
PGHOST=localhost
PGPORT=5432
PGDATABASE=riskql
PGUSER=your_db_user
# Leave blank for local trust/peer auth.
PGPASSWORD=
