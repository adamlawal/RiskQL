# =============================================================================
# RiskQL environment configuration (EXAMPLE)
# Copy this file to `.env` and fill in your local values.
#   cp .env.example .env
# `.env` is git-ignored and must NEVER be committed.
# =============================================================================

# Full connection string used by the Python notebook (and optionally psql).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://localhost:5432/riskql

# Individual PG* variables (used by psql / libpq if you prefer them).
PGHOST=localhost
PGPORT=5432
PGDATABASE=riskql
PGUSER=your_db_user
# Leave blank if your local Postgres uses trust/peer auth; otherwise set it.
PGPASSWORD=
